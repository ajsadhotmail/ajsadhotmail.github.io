---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { CATEGORIES } from "@/data/categories";
import { tplStr, useTranslations } from "@/i18n";
import { postFilter } from "@/utils/postFilter";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = (await getCollection("posts")).filter(postFilter);
const countByCategory = new Map(
  CATEGORIES.map(category => [
    category.name,
    posts.filter(post => post.data.category === category.name).length,
  ])
);
---

<Layout
  title={`${t.pages.categoriesTitle} | ${config.site.title}`}
  description={t.pages.categoriesDesc}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.categoriesTitle} pageDesc={t.pages.categoriesDesc}>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {
        CATEGORIES.map(category => (
          <li>
            <a
              href={getRelativeLocaleUrl(
                locale,
                `categories/${category.slug}/`
              )}
              class="hover:border-accent flex h-full flex-col rounded-none border border-[1.5px] px-4 py-3 transition-colors"
            >
              <span class="text-accent decoration-dashed underline-offset-4 group-hover:underline sm:text-lg">
                {category.name}
              </span>
              <span class="text-muted-foreground mt-2 text-sm leading-relaxed">
                {category.description}
              </span>
              <span class="text-muted-foreground mt-auto pt-4 text-xs">
                {tplStr(t.pages.categoryPostCount, {
                  count: countByCategory.get(category.name) ?? 0,
                })}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
